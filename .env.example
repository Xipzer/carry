# Public Reown project ID, not a private API key. Allowlist your deployed origin.
VITE_WALLETCONNECT_PROJECT_ID=
# Safety gate: keep false until live testnet/recovery validation and security review are complete.
# This only gates NEW mainnet burns. Recovery/receiving remains available.
VITE_ENABLE_MAINNET_TRANSFERS=false
# Receiving route on a fresh page: manual or automatic (paid Circle relaying).
# Quotes always disclose fees before the source burn. No automatic manual fallback.
VITE_DEFAULT_RECEIVING=manual
# Optional public, browser-safe RPC overrides keyed by EVM chain ID.
# VITE_RPC_URLS={"8453":["https://mainnet.base.org"]}
